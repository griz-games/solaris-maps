{
  "permissions": {
    "allow": [
      "Bash(python -m solarismap:*)",
      "Bash(python maps/:*)",
      "Bash(python tests/:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_edit.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_out.py\""
          }
        ]
      }
    ]
  }
}
